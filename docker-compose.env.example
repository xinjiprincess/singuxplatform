# Copy this file to .env before running docker compose.
#
# On Windows, prefer forward slashes in paths, for example:
# ORIGO_BACKEND_DIR=C:/path/to/nuwax-backend

ORIGO_BACKEND_DIR=D:/singuxplatform/nuwax-backend
PLATFORM_ADMIN_USER_IDS=
PLATFORM_TENANT_POLICY_ENABLED=false
PLATFORM_MEMBERSHIP_ENABLED=false
PLATFORM_PUBLIC_HOSTS=www.ciyuancenter.cc

FRONTEND_PORT=8080
MYSQL_PORT=3306
REDIS_PORT=6379
ELASTICSEARCH_PORT=9200
MILVUS_PORT=19530
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MYSQL_ROOT_PASSWORD=singular_origo_root_password
MYSQL_DATABASE=agent_platform
DORIS_DB_NAME=agent_custom_table
JWT_SECRET_KEY=change_me_to_a_32_char_minimum_secret

# Leave Redis password empty for the bundled local Redis.
REDIS_PASSWORD=
REDIS_DB=1

# External services used by AppDev, code execution, logs, and agent runtime.
# For local services on the Docker host, host.docker.internal works on Docker Desktop
# and is mapped through host-gateway in docker-compose.yml for Linux engines.
MCP_PROXY_URL=http://host.docker.internal:8020
CODE_EXECUTE_URL=http://host.docker.internal:8020/api/run_code_with_log
LOG_SERVICE_URL=http://host.docker.internal:8097
BUILD_SERVER_URL=http://host.docker.internal:60000/api
AI_AGENT_URL=http://host.docker.internal:8086
DOCKER_PROXY_URL=http://host.docker.internal:8088

# Optional model proxy base URL.
MODEL_API_BASE_URL=
